{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "allowJs": true,
    "noImplicitAny": false,
    "sourceMap": true
  },
  "include": [
    "scripts/**/*.ts",
    "test/**/*.ts",
    "contracts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}

  
  